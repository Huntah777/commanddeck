{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "git pull every hour",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "while ($true) { git -C \"${workspaceFolder}\" pull; Start-Sleep -Seconds 3600 }"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
